# URL the phone will use to reach this server (scheme + host [+ port]).
PUBLIC_URL=https://omni.example.com
# Domain for the optional Caddy TLS profile (docker compose --profile tls up -d)
DOMAIN=omni.example.com
# Fixed token (otherwise one is generated and stored in data/token)
OMNI_TOKEN=
PORT=7788
# Where your apps live (default: ./apps)
#OMNI_APPS_DIR=
# App secrets: anything here is available to apps as ctx.env.NAME
#WEATHER_API_KEY=
# Demo apps that need keys (all optional):
#TODOIST_TOKEN=            # Todoist → Settings → Integrations → Developer
#TODOIST_PROJECT=Work      # project name tasks are added to / listed from (default: Inbox)
#DEEPGRAM_API_KEY=         # Transcribe: live captions (Flux or nova-3) + the accurate second pass (console.deepgram.com)
#GEMINI_API_KEY=           # Transcribe: cues via Gemini 3.5 Flash-Lite (fast, cheap); GEMINI_MODEL overrides the model
#ANTHROPIC_API_KEY=        # Transcribe: summaries (+ cues if no Gemini key); falls back to the local `claude` CLI if unset
#SYSMON_NAME=              # label shown by the system monitor instead of the hostname
